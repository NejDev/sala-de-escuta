# Login via PKCE: the Client Secret is NOT needed (and must not be stored here).
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Public address (tunnel) that friends use to get in, e.g. https://my-pc.tailnet.ts.net
# Also register <address>/callback as a Redirect URI in the Spotify app.
SALA_PUBLIC_URL=
# Language of the command line and of automatic updates: en or pt. In the panel each person picks their own.
SALA_LANG=en
# Optional: song listeners counted on Last.fm, for the discoveries' filter.
# Create a free API account at https://www.last.fm/api/account/create and paste the "API key" here.
LASTFM_API_KEY=
