# Login via PKCE: o Client Secret NÃO é necessário (e não deve ficar aqui).
SPOTIFY_CLIENT_ID=seu_client_id
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Endereço público (túnel) por onde os amigos entram, ex.: https://meu-pc.tailnet.ts.net
# Cadastre também <endereço>/callback como Redirect URI no app do Spotify.
SALA_PUBLIC_URL=
